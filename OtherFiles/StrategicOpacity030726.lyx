\begin_layout Title
Strategic Opacity
\end_layout

\begin_layout Section
Problem
\end_layout

\begin_layout Standard
The expected utility (given 
\begin_inset Formula $\beta$
\end_inset

;
 before any costs) is 
\begin_inset Formula 
\[
U(\beta)=\phi(1+\theta)\mathrm{E}[\pi]=\phi(1+\theta)\frac{\beta\omega_{s}\omega_{u}}{\beta^{2}\omega_{s}+\omega_{u}}.
\]

\end_inset

 
\begin_inset Formula $\beta$
\end_inset

 is one of the solutions to the fixed-point problem 
\begin_inset Formula $\beta=F(\beta)$
\end_inset

,
 which reduces to 
\begin_inset Formula 
\[
(k-a)(k+b)^{2}-2\theta ak^{2}=0,
\]

\end_inset

with 
\begin_inset Formula $k=\beta^{2}$
\end_inset

,
 
\begin_inset Formula $a=\omega_{u}/\omega_{s},$
\end_inset

and 
\begin_inset Formula $b=\omega_{e}/\omega_{s}$
\end_inset

.
 Denote 
\begin_inset Formula $z\equiv k/a=\beta^{2}\frac{\omega_{s}}{\omega_{u}}$
\end_inset

.
 The objective function and the fixed-point problem are rewritten as 
\begin_inset Formula 
\[
U(z)=\sqrt{\omega_{s}\omega_{u}}\phi(1+\theta)\frac{\sqrt{z}}{z+1},
\]

\end_inset

and
\begin_inset Formula 
\[
(z-1)\left(z+\frac{\omega_{e}}{\omega_{u}}\right)^{2}-2\theta z^{2}=0.
\]

\end_inset

Denote the net expected utility by 
\begin_inset Formula $V=E_{\beta}[U]-C$
\end_inset

,
 where 
\begin_inset Formula $E_{\beta}$
\end_inset

[] denotes the expectation about 
\begin_inset Formula $\beta$
\end_inset

 (which is 
\begin_inset Formula $\beta_{H}$
\end_inset

 with prob 
\begin_inset Formula $\rho_{H}$
\end_inset

 and 
\begin_inset Formula $\beta_{L}$
\end_inset

 otherwise;
 when unique solution,
 either one of 
\begin_inset Formula $\rho$
\end_inset

 is 1).
 The optimal 
\begin_inset Formula $\omega_{e}$
\end_inset

 is determined by the first-order condition:
\begin_inset Formula 
\[
\frac{dV}{d\omega_{e}}=\phi(1+\theta)\sqrt{\omega_{u}\omega_{s}}\times\frac{d}{d\omega_{e}}\mathrm{E}_{\beta}\left[\frac{\sqrt{z}}{z+1}\right]-C'(\omega_{e})=0.
\]

\end_inset

Note that 
\begin_inset Formula $\frac{d}{dz}\left(\frac{\sqrt{z}}{z+1}\right)=\frac{1}{2\sqrt{z}}\frac{1-z}{(1+z)^{2}}<0$
\end_inset

.
\end_layout

\begin_layout Lemma
Denote 
\begin_inset Formula $h=\omega_{u}/\omega_{e}$
\end_inset

.
 If and only if 
\begin_inset Formula $h>8$
\end_inset

,
 there are two thresholds of 
\begin_inset Formula $\theta$
\end_inset

,
 denoted by 
\begin_inset Formula $\theta_{H}$
\end_inset

 and 
\begin_inset Formula $\theta_{L}$
\end_inset

.
 They are given by the solutions to 
\begin_inset Formula 
\[
R(\theta)=8h^{3}\theta^{2}+\theta h(8h^{2}-20h-1)+2(1+h)^{3}=0.
\]

\end_inset

Both 
\begin_inset Formula $\theta_{H}$
\end_inset

 and 
\begin_inset Formula $\theta_{L}$
\end_inset

 are monotonically increasing in 
\begin_inset Formula $\omega_{e}.$
\end_inset

 Then,
 
\begin_inset Formula $\omega_{H}$
\end_inset

 and 
\begin_inset Formula $\omega_{L}$
\end_inset

 are given by 
\begin_inset Formula $\omega_{e}$
\end_inset

 such that 
\begin_inset Formula $\theta=\theta_{L}$
\end_inset

 and 
\begin_inset Formula $\theta=\theta_{H}$
\end_inset

,
 respectivel (note that 
\begin_inset Formula $\theta_{L}<\theta_{H}$
\end_inset

 so that 
\begin_inset Formula $\omega_{L}<\omega_{H}$
\end_inset

).
 
\end_layout

