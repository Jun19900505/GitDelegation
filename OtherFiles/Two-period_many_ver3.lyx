\end_layout

\begin_layout Plain Layout


\backslash
Lambda(z)={}&9z^{26}+15z^{24}-345z^{22}+168z^{21}-2121z^{20}+1260z^{19}-5100z^{18}+4200z^{17}-4666z^{16}
