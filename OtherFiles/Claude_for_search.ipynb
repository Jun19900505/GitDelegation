   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": "# ============================================================\n# Section D: Plot\n# ============================================================\ny_lim_a = [np.nanmin(we_star_a)*0.9,  wL_f*0.22,  wL_f*0.93,  np.nanmax(we_star_a)*1.02]\ny_lim_b = [wL_f*0.92, wL_f*1.12,  wH_f*0.97,  wH_f*1.05]\ny_lim_c = [wL_f*0.99, wL_f*1.01,  wH_f*0.97,  np.nanmax(we_star_c)*1.02]\n\nfig = plt.figure(figsize=(12, 6))\ngs_main = fig.add_gridspec(1, 3, wspace=0.35)\n\n# ---- Panel A: Low Average Skill ----\nratio_a = [y_lim_a[3]-y_lim_a[2], y_lim_a[1]-y_lim_a[0]]\ngs_a    = gs_main[0, 0].subgridspec(2, 1, height_ratios=ratio_a, hspace=0.1)\nax_a_top = fig.add_subplot(gs_a[0, 0])\nax_a_bot = fig.add_subplot(gs_a[1, 0], sharex=ax_a_top)\ndraw_broken_axis(ax_a_top, ax_a_bot, ws_grid_a, we_star_a, y_lim_a, r, 'lower right')\nax_a_top.axhline(wL_f, color='k', lw=0.9, ls='--')\nax_a_top.text(max(ws_grid_a)*1.01, wL_f, r'$\\omega_L$', fontsize=12, va='center')\nax_a_all = fig.add_subplot(gs_a[:], frameon=False)\nax_a_all.tick_params(labelcolor='none', top=False, bottom=False, left=False, right=False)\nax_a_all.set_ylabel(r\"Optimal Opacity ($\\omega_{\eta}^*$)\", fontsize=14, labelpad=10)\nax_a_bot.set_xlabel(r\"Average Skill ($\\omega_s$)\", fontsize=14, labelpad=8)\nax_a_all.set_title(\"(A) Low Average Skill\", y=-0.22, fontsize=13)\n\n# ---- Panel B: Intermediate Average Skill ----\nratio_b = [y_lim_b[3]-y_lim_b[2], y_lim_b[1]-y_lim_b[0]]\ngs_b    = gs_main[0, 1].subgridspec(2, 1, height_ratios=ratio_b, hspace=0.1)\nax_b_top = fig.add_subplot(gs_b[0, 0])\nax_b_bot = fig.add_subplot(gs_b[1, 0], sharex=ax_b_top)\ndraw_broken_axis(ax_b_top, ax_b_bot, ws_grid_b, we_star_b, y_lim_b, r, 'lower right')\nax_b_bot.axhline(wL_f, color='k', lw=0.9, ls='--')\nax_b_top.axhline(wH_f, color='k', lw=0.9, ls='--')\nax_b_bot.text(max(ws_grid_b)*1.01, wL_f, r'$\\omega_L$', fontsize=12, va='center')\nax_b_top.text(max(ws_grid_b)*1.01, wH_f, r'$\\omega_H$', fontsize=12, va='center')\nax_b_all = fig.add_subplot(gs_b[:], frameon=False)\nax_b_all.tick_params(labelcolor='none', top=False, bottom=False, left=False, right=False)\nax_b_all.set_ylabel(r\"Optimal Opacity ($\\omega_{\eta}^*$)\", fontsize=14, labelpad=10)\nax_b_bot.set_xlabel(r\"Average Skill ($\\omega_s$)\", fontsize=14, labelpad=8)\nax_b_all.set_title(\"(B) Intermediate Average Skill\", y=-0.22, fontsize=13)\n\n# ---- Panel C: High Average Skill ----\nratio_c = [y_lim_c[3]-y_lim_c[2], y_lim_c[1]-y_lim_c[0]]\ngs_c    = gs_main[0, 2].subgridspec(2, 1, height_ratios=ratio_c, hspace=0.1)\nax_c_top = fig.add_subplot(gs_c[0, 0])\nax_c_bot = fig.add_subplot(gs_c[1, 0], sharex=ax_c_top)\ndraw_broken_axis(ax_c_top, ax_c_bot, ws_grid_c, we_star_c, y_lim_c, r, 'lower right')\nax_c_bot.axhline(wL_f, color='k', lw=0.9, ls='--')\nax_c_top.axhline(wH_f, color='k', lw=0.9, ls='--')\nax_c_bot.text(max(ws_grid_c)*1.01, wL_f, r'$\\omega_L$', fontsize=12, va='center')\nax_c_top.text(max(ws_grid_c)*1.01, wH_f, r'$\\omega_H$', fontsize=12, va='center')\nax_c_all = fig.add_subplot(gs_c[:], frameon=False)\nax_c_all.tick_params(labelcolor='none', top=False, bottom=False, left=False, right=False)\nax_c_all.set_ylabel(r\"Optimal Opacity ($\\omega_{\eta}^*$)\", fontsize=14, labelpad=10)\nax_c_bot.set_xlabel(r\"Average Skill ($\\omega_s$)\", fontsize=14, labelpad=8)\nax_c_all.set_title(\"(C) High Average Skill\", y=-0.22, fontsize=13)\n\nout = 'Figures/fig_opacity_search_r09'\nplt.savefig(out + '.pdf', bbox_inches='tight', dpi=150)\nplt.savefig(out + '.png', bbox_inches='tight', dpi=150)\nplt.show()\nprint(\"Figure saved.\")\n"
